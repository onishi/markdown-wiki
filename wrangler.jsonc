{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markdown-wiki",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Google login: set GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET with `wrangler secret put`.
  "vars": { "APP_ORIGIN": "https://markdown-wiki.wagaya.workers.dev" },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "WIKI", "class_name": "WikiServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WikiServer"] }]
}
