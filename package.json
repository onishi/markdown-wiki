{
  "name": "markdown-wiki",
  "version": "1.0.0",
  "description": "Markdown Wiki - GFM wiki with block-level source editing",
  "scripts": {
    "dev": "concurrently -k -n server,web \"DEV_LOGIN=1 tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p . && tsc -p worker",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "vite build && wrangler deploy",
    "test:e2e:cf": "vite build && playwright test -c playwright.cloudflare.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onishi/markdown-wiki.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/onishi/markdown-wiki/issues"
  },
  "homepage": "https://github.com/onishi/markdown-wiki#readme",
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@hono/node-server": "^2.1.6",
    "decode-named-character-reference": "^1.3.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.6",
    "hono": "^4.13.16",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "node-diff3": "^3.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "private": true
}
