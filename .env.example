# Copy to .env (gitignored) and fill in. Real environment variables take precedence.
# The API port is not set here: pass PORT on the command line (e.g. PORT=3301 npm run dev)
# so that the server and the Vite proxy agree.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Origin the browser uses. Register <APP_ORIGIN>/auth/google/callback as a redirect URI.
APP_ORIGIN=http://localhost:5173
